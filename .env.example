# Environment Variables Template for Vercel Deployment
# Copy these environment variables to your Vercel dashboard

# MongoDB Atlas Connection (Replace with your connection string)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_2024
JWT_EXPIRY=24h

# OpenAI Configuration (Replace with your API key)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# Admin Defaults
DEFAULT_ADMIN_EMAIL=admin@smartexam.com
DEFAULT_ADMIN_PASSWORD=admin123

# Email Configuration (Optional - Update later)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
EMAIL_FROM=noreply@smartexamsystem.com

# Other Configuration
NODE_ENV=production
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX=100
